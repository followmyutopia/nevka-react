{
  "expo": {
    "name": "Nevka",
    "slug": "Nevka",
    "version": "0.37",
    "orientation": "portrait",
    "icon": "./assets/icns/ios-dark.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icns/splash-icon-light.png",
      "resizeMode": "contain",
      "backgroundColor": "#122730"
    },
    "ios": {
      "supportsTablet": true,
      "icon": {
        "dark": "./assets/icns/ios-dark.png",
        "light": "./assets/icns/ios-light.png",
        "tinted": "./assets/icns/ios-tinted.png"
      },
      "bundleIdentifier": "com.followmyutopia.Nevka"
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icns/adaptive-icon.png",
        "backgroundColor": "#122730"
      },
      "permissions": [],
      "package": "com.followmyutopia.Nevka"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your friends."
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#b5d5e3",
          "image": "./assets/icns/splash-icon-dark.png",
          "dark": {
            "image": "./assets/icns/splash-icon-light.png",
            "backgroundColor": "#122730"
          },
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "80934168-3872-486f-af7f-25249a5921b4"
      }
    }
  }
}
