{
  "expo": {
    "name": "Nevka",
    "slug": "Nevka",
    "version": "1.3.11",
    "orientation": "portrait",
    "icon": "./assets/icns/ios-dark.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icns/splash-icon-light.png",
      "resizeMode": "contain",
      "backgroundColor": "#122730"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icns/nevka.icon",
      "bundleIdentifier": "com.followmyutopia.nevka",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icns/adaptive-icon.png",
        "backgroundColor": "#122730"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.followmyutopia.nevka"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icns/favicon.ico"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your friends."
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#b5d5e3",
          "image": "./assets/icns/splash-icon-dark.png",
          "dark": {
            "image": "./assets/icns/splash-icon-light.png",
            "backgroundColor": "#122730"
          },
          "imageWidth": 200
        }
      ],
      "expo-localization",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "80934168-3872-486f-af7f-25249a5921b4"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/80934168-3872-486f-af7f-25249a5921b4"
    }
  }
}
